              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "generate_lead"
              }
            ]
          }
        ],
        "notes": "No toque em 'Abrir conta' ou 'Quero abrir' na tela de acesso (abertura_conta) e em 'Pedir o Black' (cartao_black) ou 'Pedir adicional' (cartao_adicional) na tela Cartões. Sai depois do click e, nos banners, depois de select_promotion."
      },
